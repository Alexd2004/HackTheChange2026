# App (Expo). Copy to .env and fill in from Supabase → Connect.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
EXPO_PUBLIC_USE_MOCK=0
# Testing/demo only: 1 = every finished level counts as passed (even under 60%). Never ship a build with 1.
EXPO_PUBLIC_ADMIN_BYPASS=0
